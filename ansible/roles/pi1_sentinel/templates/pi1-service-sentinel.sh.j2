#!/bin/sh
set -u

settings_file="{{ pi1_sentinel_config_dir }}/settings.tsv"
heartbeats_file="{{ pi1_sentinel_config_dir }}/heartbeats.tsv"
interval_seconds="{{ pi1_sentinel_interval_seconds }}"
dns_timeout_seconds="{{ pi1_sentinel_dns_timeout_seconds }}"
http_timeout_seconds="{{ pi1_sentinel_http_timeout_seconds }}"
tab="$(printf '\t')"

publish_heartbeat() {
  check_name="$1"
  check_url="$2"
  if ! /usr/bin/curl \
    --fail \
    --silent \
    --show-error \
    --max-time "$http_timeout_seconds" \
    --retry 2 \
    --retry-delay 1 \
    -- "$check_url" >/dev/null 2>&1; then
    printf 'Healthchecks update failed for %s\n' "$check_name" >&2
  fi
}

heartbeat_url() {
  check_name="$1"
  /usr/bin/awk -F "$tab" -v name="$check_name" \
    '$1 == name { print $2; exit }' "$heartbeats_file"
}

dns_succeeds() {
  transport="$1"
  set -- \
    "@$dns_server" \
    "$dns_query_name" \
    A \
    +short \
    +tries=1 \
    "+time=$dns_timeout_seconds"
  if [ "$transport" = tcp ]; then
    set -- "$@" +tcp
  fi
  result="$(/usr/bin/dig "$@" 2>/dev/null)"
  [ -n "$result" ]
}

while :; do
  IFS="$tab" read -r dns_server dns_query_name http_url < "$settings_file"

  if dns_succeeds udp; then
    publish_heartbeat dns-udp "$(heartbeat_url dns-udp)"
  fi
  if dns_succeeds tcp; then
    publish_heartbeat dns-tcp "$(heartbeat_url dns-tcp)"
  fi
  if /usr/bin/curl \
    --fail \
    --location \
    --silent \
    --show-error \
    --max-time "$http_timeout_seconds" \
    -- "$http_url" >/dev/null 2>&1; then
    publish_heartbeat http "$(heartbeat_url http)"
  fi

  publish_heartbeat sentinel "$(heartbeat_url sentinel)"
  /bin/sleep "$interval_seconds"
done
